# Byte-identity for the append-only results store and generated tables (TESTPLAN 7.2/7.5)
*.jsonl -text
results/tables/*.md -text
results/FLAGS.md -text

# Shell scripts are authored on Windows and executed on rented Linux boxes. This repo
# has core.autocrlf on, so without this rule a checkout rewrites *.sh to CRLF and bash
# then fails on `do\r` and on `\` continuations that are no longer continuations. That
# broke the whole gap-closing run plan once before it ever left the ground.
*.sh text eol=lf

# B8 task manifests: fixture_sha (Task 3, llmtest/harness/tasks.py) hashes
# the raw manifest file bytes -- force LF checkouts so that hash is stable
# across Windows/Linux clones (a CRLF checkout would silently change every
# fixture_sha and setup_repo_sha).
suite/b8_harness/*.yaml text eol=lf
