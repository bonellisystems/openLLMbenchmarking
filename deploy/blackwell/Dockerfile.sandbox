# B8 containment image (b8-sandbox:1): Node (for OpenCode) + Python3 (for
# oracles) + a PINNED opencode-ai. Byte-identical to the recipe verified live
# on the Windows box (W2 containment). Built ON the run box by bootstrap.sh;
# never pulled from a registry (no pull -> no supply-chain surface at run time).
FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip git ca-certificates bash coreutils \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g opencode-ai@1.2.15
# node:20-slim already ships a non-root `node` user (uid 1000); the Sandbox
# runs it with --read-only rootfs + a writable /workspace mount + fresh HOME.
RUN node --version && python3 --version \
    && (which opencode && opencode --version || ls -la /usr/local/lib/node_modules/opencode-ai/ | head)
