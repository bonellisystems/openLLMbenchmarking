# Evidence artifacts — hashed on result rows, never committed
artifacts/

# Secrets — configs are committed as templates only
.env
*.key

# Model weights — never in version control
*.gguf
*.safetensors

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Python build artifacts
*.egg-info/

# Node (Playwright gate harness)
node_modules/
playwright-report/

# OS junk
Thumbs.db
.DS_Store

# operational scratch (assessment session)
.tmp_chunks/
server.gpu*.log
/scratchpad/
