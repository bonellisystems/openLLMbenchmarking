# Evidence artifacts — hashed on result rows, never committed
artifacts/

# Secrets — configs are committed as templates only
.env
*.key

# Model weights — never in version control
*.gguf
*.safetensors

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Python build artifacts
*.egg-info/

# Node (Playwright gate harness)
node_modules/
playwright-report/

# OS junk
Thumbs.db
.DS_Store

# operational scratch (assessment session)
.tmp_chunks/
server.gpu*.log
# Ignore the scratch dir CONTENTS but keep the p8 generation drivers: B4/B7 and B5 are
# produced by p8_gen_serving.py / p8_gen_b5.py, which are load-bearing project code that
# merely happens to live here. They were silently untracked - `git add` on an ignored
# path is a no-op, so several commits described changes to them that were never actually
# stored, and a clean checkout would have lost the env overrides and the fixes.
# (Negation cannot escape an ignored DIRECTORY, hence /scratchpad/* rather than
# /scratchpad/.)
/scratchpad/*
!/scratchpad/p8_gen_serving.py
!/scratchpad/p8_gen_b5.py

# shipping tarball, rebuilt by scripts/rent_and_run.py on every launch
plan/repo.tgz
plan_bonsai/repo.tgz
plan_bonsai/INSTANCE
plan_bonsai/ENDPOINT

# Ephemeral pointers to a rented instance, rewritten on every launch and meaningless
# once the box is destroyed.
plan/INSTANCE
plan/ENDPOINT

# Staging trees: results are PULLED into these from a rented box and then merged into
# the canonical shards (results/, results_games/, results_security/, results_tools/,
# results_b8_*). Keeping both would double the data and let the two drift.
results_gapclose/
results_box/
results_laguna*/
results_local_*/
results_conf_*/
results_smoke_*/
results_test/

# Local Netlify folder
.netlify

# Superseded pull/staging trees, moved aside 2026-08-03 so a habitual merge_gapclose
# run can never re-import pre-v2.2.0 rows. Canonical data lives in results*/ shards.
_archive/
